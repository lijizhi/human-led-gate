{
  "name": "humanled",
  "version": "0.4.0",
  "description": "Human-led development for AI coding agents: a risk-tiered collaboration protocol plus a real PreToolUse gate that denies out-of-scope writes before they happen.",
  "license": "MIT",
  "bin": {
    "humanled": "bin/humanled.js"
  },
  "scripts": {
    "test": "node --test test/gate.test.js test/protections.test.js test/docs-truth.test.js",
    "docs:numbers": "node scripts/doc-numbers.js",
    "docs:check": "node scripts/doc-numbers.js --check && node scripts/verify-freshness.js",
    "docs:fresh": "node scripts/verify-freshness.js --strict"
  },
  "files": [
    "bin/",
    "hooks/",
    "templates/",
    "skills/",
    "adapters/",
    ".claude-plugin/",
    "docs/verify.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "ai-coding-agent",
    "agents-md",
    "guardrails",
    "human-in-the-loop",
    "hooks",
    "cursor",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijizhi/human-led-gate.git"
  }
}
